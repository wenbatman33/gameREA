{
  "browser": {
    "mode": "launch",
    "executable_path": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
    "headless": true
  },
  "start_url": {
    "url": "https://www.pragmaticplay.com/en/games/the-dog-house-slot/?cur=USD&gamelang=en"
  },
  "environment": {
    "locale": "en-US",
    "timezone": "Asia/Taipei"
  },
  "actions": [
    {
      "step_id": "settle",
      "action": "wait_for_timeout",
      "duration_ms": 18000
    }
  ],
  "capture": {
    "at_end": [
      "url",
      "dom",
      "screenshot",
      "accessibility"
    ],
    "events": [
      "network",
      "console"
    ],
    "network": {
      "response_body": true,
      "request_body": true,
      "header_values": false
    },
    "limits": {
      "max_events": 20000,
      "max_total_event_allocation_bytes": 67108864,
      "max_network_body_bytes": 5242880,
      "max_network_body_allocation_bytes": 33554432
    }
  }
}